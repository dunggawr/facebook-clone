{
  "name": "facebook-clone",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:worker": "pnpm --filter worker dev",
    "build": "pnpm -r build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  }
}
